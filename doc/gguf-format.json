{
    "format": "GGUF",
    "version_supported": 3,
    "byte_order": "little-endian",
    "description": "GGUF 文件格式完整描述（依据本仓库 GGUFLoader.hpp / GGMLType.hpp / GGUFModelWeights 实现）",
    "layout": [
        {
            "section": "① Header 文件头",
            "fixed_size_bytes": 24,
            "fields": [
                {
                    "name": "magic",
                    "offset": 0,
                    "type": "uint32_t",
                    "size_bytes": 4,
                    "value": "0x46554747",
                    "ascii": "GGUF"
                },
                {
                    "name": "version",
                    "offset": 4,
                    "type": "uint32_t",
                    "size_bytes": 4,
                    "value": 3
                },
                {
                    "name": "tensor_count",
                    "offset": 8,
                    "type": "uint64_t",
                    "size_bytes": 8,
                    "description": "张量总数"
                },
                {
                    "name": "metadata_kv_count",
                    "offset": 16,
                    "type": "uint64_t",
                    "size_bytes": 8,
                    "description": "元数据键值对数量"
                }
            ]
        },
        {
            "section": "② Metadata KV 列表",
            "repeat": "metadata_kv_count 次",
            "entry": {
                "key": {
                    "type": "字符串：uint64_t 长度 + UTF-8 内容（无结束符）"
                },
                "value_type": {
                    "type": "uint32_t",
                    "enum": "GGUFValueType（见 value_types 节）"
                },
                "value": {
                    "type": "变长，按 value_type 编码；ARRAY 可递归嵌套"
                }
            }
        },
        {
            "section": "③ Tensor 信息表",
            "repeat": "tensor_count 次",
            "entry": [
                {
                    "name": "name",
                    "type": "字符串（长度前缀，同 key 格式）"
                },
                {
                    "name": "n_dimensions",
                    "type": "uint32_t",
                    "description": "维度数量"
                },
                {
                    "name": "dimensions",
                    "type": "uint64_t × n_dimensions",
                    "description": "各维度大小"
                },
                {
                    "name": "data_type",
                    "type": "uint32_t",
                    "enum": "GGMLType（见 ggml_types 节）"
                },
                {
                    "name": "offset",
                    "type": "uint64_t",
                    "description": "张量数据在文件中的起始偏移（从文件头计）"
                }
            ]
        },
        {
            "section": "④ Tensor Data 数据区",
            "description": "所有张量原始数据按 offset 依次存放；长度 = ceil(元素数 / block_size) × type_size；数据可能未对齐，按字节偏移直接读取"
        }
    ],
