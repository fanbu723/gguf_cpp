    "tensor_data_formula": {
        "description": "张量数据长度与总字节数计算",
        "element_count": "n = prod(dimensions)",
        "total_bytes": "ceil(n / block_size) × type_size",
        "note": "block_size 与 type_size 由 GGMLType 决定：F32=4、F16/BF16=2、Q4_0=18 等；非量化类型 block_size = 1"
